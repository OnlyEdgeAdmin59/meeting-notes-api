ANTHROPIC_API_KEY=sk-ant-...
# Postgres de Render (Internal Database URL). Sin esto usa SQLite local.
DATABASE_URL=postgres://usuario:clave@host:5432/notemeeting
# URL pública del servicio: se usa para los links "Marcar como hecha" en Slack (debe ser https)
PUBLIC_BASE_URL=https://meeting-notes-api-rbag.onrender.com
# Recordatorios diarios: 1 = activar el scheduler interno (requiere instancia que no se duerma)
ENABLE_SCHEDULER=1
REMINDER_TZ=America/Chicago
REMINDER_HOUR=9
# Secreto para POST /api/cron/reminders (opcional, si usas un cron externo)
CRON_SECRET=genera-uno-largo
# (Legacy) API keys fijas separadas por coma. Los clientes nuevos se crean con: python admin.py add
CLIENT_API_KEYS=key-cliente-1,key-cliente-2
